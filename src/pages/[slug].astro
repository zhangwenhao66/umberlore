---
import Layout from '../layouts/Layout.astro';
import Article from '../../vendor/site-toolkit/packages/schema/src/Article.astro';
import BreadcrumbList from '../../vendor/site-toolkit/packages/schema/src/BreadcrumbList.astro';
import FAQPage from '../../vendor/site-toolkit/packages/schema/src/FAQPage.astro';
import { pickRelatedGuidesWithFallback } from '../lib/relatedGuides';
import { guides, categorySlug, type Guide } from '../data/guides';
import { AUTHOR_NAME, SITE_ORIGIN } from '../consts';

export function getStaticPaths() {
	return guides.map((guide) => ({
		params: { slug: guide.slug },
		props: { guide },
	}));
}

interface Props {
	guide: Guide;
}

const { guide } = Astro.props;
// Rotating-window same-category selection, padded with a cross-category
// fallback (singletons get priority so they always pick up at least one
// inbound link) -- see src/lib/relatedGuides.ts for why and
// vendor/site-toolkit/packages/related-guides for the underlying same-
// category rotation this builds on.
const relatedFinal = pickRelatedGuidesWithFallback(guides, guide);

// Categories are open strings here (UmberLore spans the whole of art history rather
// than a fixed set of pillars), so the path is derived rather than looked up.
const catPath = `/topics/${categorySlug(guide.category)}/`;

const pageUrl = `${SITE_ORIGIN}/${guide.slug}/`;
const heroImage = `${SITE_ORIGIN}${guide.image ?? '/favicon.svg'}`;
const toISO = (d: string) => `${d}T00:00:00+00:00`;
const breadcrumbItems = [
	{ name: 'Home', item: `${SITE_ORIGIN}/` },
	{ name: guide.category, item: `${SITE_ORIGIN}${catPath}` },
	{ name: guide.title, item: pageUrl },
];

function md(text: string): string {
	return text
		.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
		.replace(/\*(.*?)\*/g, '<em>$1</em>')
		.replace(/\[([^\]]+)\]\(((?:[^()]|\([^()]*\))*)\)/g, '<a href="$2">$1</a>');
}
import fs from 'node:fs';
import path from 'node:path';
import { imgDims } from '../data/imageDims';
import { RESPONSIVE_HERO } from '../data/responsiveHero';
// 2026-09-13 响应式 hero 图：见 独立站/CWV月检记录.md「响应式图片改造」一节。本站 hero 图
// 用 contain 布局保留原图完整宽高比（不像 factcrumbs/warcrumbs 裁成固定 16:9），真实展示
// 宽度是 `.hero-plate` 的 `min(100%, calc(<断点maxHeight> * w/h))` 公式算出来的、随每张图
// 宽高比变化的值——所以 sizes 不能写死一个容器宽度，要把这张图自己的 w/h 代进同一条公式，
// 让浏览器按这张图实际会渲染多宽来选 srcset 档位（跟 CSS 里 .hero-plate 用的公式必须一致，
// 否则会选错档）。580px/880px 分别对应 main 在 <768px / ≥768px 两档的左右内边距（20px/32px）
// 相对 mx-auto max-w-[880px] 外层容器算出的可用宽度上限。
const heroDims = guide.image ? imgDims(guide.image) : undefined;
const heroResponsive = guide.image ? RESPONSIVE_HERO[guide.image] : undefined;
const heroSizes = heroDims
	? `(min-width: 768px) min(calc(100vw - 64px), 880px, calc(72vh * ${heroDims.w} / ${heroDims.h})), min(calc(100vw - 40px), calc(585px * ${heroDims.w} / ${heroDims.h}))`
	: undefined;
// 2026-09-15 CWV 跟进：跟 factcrumbs/warcrumbs 同款 WebP + preload 手法（gen-responsive-images.py
// 现在也给 contain 模式生成同名 WebP 兄弟文件，quality=75，不改变任何宽高/裁剪数值——只加一份
// 更小的等效编码，<picture> 包裹不影响 `.plate` 的 CSS 计算，因为视觉盒子仍由内部 <img> 的
// width/height/style 决定，<picture> 本身不参与布局）。这几行只做字节层面优化，不碰上面
// `.plate`/`--pw`/`--ph` 那套五轮才排查清楚的 CLS 逻辑一个字符。
const heroWebpDesktop = (() => {
	if (!guide.image || !guide.image.match(/\.jpe?g$/i)) return null;
	const rel = guide.image.replace(/\.jpe?g$/i, '.webp');
	const abs = path.join(process.cwd(), 'public', rel.replace(/^\//, ''));
	return fs.existsSync(abs) ? rel : null;
})();
const heroWebpMobile = (() => {
	if (!heroResponsive) return null;
	const rel = heroResponsive.mobile.replace(/\.jpe?g$/i, '.webp');
	const abs = path.join(process.cwd(), 'public', rel.replace(/^\//, ''));
	return fs.existsSync(abs) ? rel : null;
})();
// 2026-09-15 二次跟进：AVIF 比同 quality 的 WebP 还小 ~27%，本站几篇卡需改进边界的页面靠这段
// 差值验证能跨过 2.5s。同 webp 一样不碰 `.plate`/`--pw`/`--ph` 的 CLS 逻辑，只加一份更小编码。
const heroAvifDesktop = (() => {
	if (!guide.image || !guide.image.match(/\.jpe?g$/i)) return null;
	const rel = guide.image.replace(/\.jpe?g$/i, '.avif');
	const abs = path.join(process.cwd(), 'public', rel.replace(/^\//, ''));
	return fs.existsSync(abs) ? rel : null;
})();
const heroAvifMobile = (() => {
	if (!heroResponsive) return null;
	const rel = heroResponsive.mobile.replace(/\.jpe?g$/i, '.avif');
	const abs = path.join(process.cwd(), 'public', rel.replace(/^\//, ''));
	return fs.existsSync(abs) ? rel : null;
})();
---

<Layout title={guide.title} description={guide.description} ogImage={guide.image ?? '/favicon.svg'} ogType="article">
	{guide.image && (
		<link
			rel="preload"
			as="image"
			type={heroAvifDesktop ? 'image/avif' : heroWebpDesktop ? 'image/webp' : undefined}
			href={heroAvifDesktop ?? heroWebpDesktop ?? guide.image}
			imagesrcset={
				heroAvifMobile
					? `${heroAvifMobile} ${heroResponsive!.w}w, ${heroAvifDesktop} ${heroDims?.w}w`
					: heroWebpMobile
						? `${heroWebpMobile} ${heroResponsive!.w}w, ${heroWebpDesktop} ${heroDims?.w}w`
						: undefined
			}
			imagesizes={heroAvifMobile || heroWebpMobile ? heroSizes : undefined}
			fetchpriority="high"
			slot="head"
		/>
	)}
	{guide.faq && guide.faq.length > 0 && <FAQPage items={guide.faq} slot="head" />}
	<Article
		slot="head"
		headline={guide.title}
		description={guide.description}
		datePublished={toISO(guide.published ?? guide.updated)}
		dateModified={toISO(guide.updated)}
		authorName={AUTHOR_NAME}
		authorUrl={`${SITE_ORIGIN}/about/`}
		image={heroImage}
		imageWidth={imgDims(heroImage)?.w}
		imageHeight={imgDims(heroImage)?.h}
		url={pageUrl}
	/>
	<BreadcrumbList slot="head" items={breadcrumbItems} />

	<div class="mx-auto max-w-[880px]">
		<nav class="mb-8 flex flex-wrap items-center gap-1.5 text-sm text-[var(--ink)]/40">
			<a href="/" class="no-underline hover:text-[var(--ink)] hover:underline">Home</a>
			<span>/</span>
			<a href={catPath} class="no-underline hover:text-[var(--ink)] hover:underline">{guide.category}</a>
		</nav>

		<header class="mx-auto max-w-[720px] text-center">
			<p class="wall-label-dept m-0">{guide.category}</p>
			<h1 class="font-display mt-3 text-4xl leading-[1.08] font-medium text-[var(--ink)] md:text-[2.85rem]">
				{guide.title}
			</h1>
			<div class="mx-auto mt-5 h-px w-14 bg-[var(--flag)]"></div>
			<p class="mt-5 text-[1.05rem] leading-relaxed text-[var(--ink)]/60">{guide.description}</p>
			<p class="mt-4 text-xs text-[var(--ink)]/40">Last updated {guide.updated}</p>
		</header>

		{guide.image && (
			<figure class="m-0 mt-10">
				{/* 2026-09-13 CLS 根因修复：`.plate` 原来是 w-fit（收缩自适应内容宽度），
				    宽度依赖 img 自身渲染出的尺寸——用 `--save-assets` 拿真实 trace 逐帧截图对比后
				    实锤：Chrome 在图片资源到位前，shrink-to-fit 的"预估宽度"计算不会正确套用
				    aspect-ratio + max-height 约束，先给出一个错误的小方块（实测 78×78），资源到位后
				    才反悔重排成正确尺寸——这才是本站 CLS 数值分毫不差、五轮改图片属性/字体都无效的
				    真正原因（此前五轮全部没找对，因为一直在查 H1/字体，而 layout-shifts 审计明确显示
				    98% 的偏移分数记在这个 .plate 节点上，只有 0.05% 是字体）。
				    直接去掉 w-fit 能消除偏移，但会让窄幅人像图（如 david-alfaro-siqueiros-portrait-1922.jpg，
				    240×634）在桌面端被横向拉伸变形（实测量出 313px 宽而非按比例应有的 221px）——因为
				    .plate 会变成占满可用宽度的块级盒子，不再收缩贴合图片。
				    真正稳妥的修法：不依赖浏览器的 shrink-to-fit 计算，改成用已知的宽高比在 CSS 里
				    直接算出 .plate 的确定宽度（`min(100%, calc(<该断点max-height> * w/h))`），
				    从第一帧起就是这个数字，不需要等图片加载完再反悔。 */}
				<div
					class="plate hero-plate mx-auto max-w-full"
					style={imgDims(guide.image) ? `--pw: ${imgDims(guide.image)!.w}; --ph: ${imgDims(guide.image)!.h};` : undefined}
				>
					<picture>
						{heroAvifDesktop && (
							<source
								srcset={heroAvifMobile ? `${heroAvifMobile} ${heroResponsive!.w}w, ${heroAvifDesktop} ${heroDims?.w}w` : heroAvifDesktop}
								sizes={heroAvifMobile ? heroSizes : undefined}
								type="image/avif"
							/>
						)}
						{heroWebpDesktop && (
							<source
								srcset={heroWebpMobile ? `${heroWebpMobile} ${heroResponsive!.w}w, ${heroWebpDesktop} ${heroDims?.w}w` : heroWebpDesktop}
								sizes={heroWebpMobile ? heroSizes : undefined}
								type="image/webp"
							/>
						)}
						<img
							src={guide.image}
							alt={guide.imageAlt ?? guide.title}
							class="mx-auto h-auto max-h-[585px] w-auto max-w-full md:max-h-[72vh]"
							loading="eager"
							fetchpriority="high"
							width={imgDims(guide.image)?.w}
							height={imgDims(guide.image)?.h}
							style={imgDims(guide.image) ? `aspect-ratio: ${imgDims(guide.image)!.w} / ${imgDims(guide.image)!.h};` : undefined}
							srcset={heroResponsive ? `${heroResponsive.mobile} ${heroResponsive.w}w, ${guide.image} ${heroDims?.w}w` : undefined}
							sizes={heroResponsive ? heroSizes : undefined}
						/>
					</picture>
				</div>
				{guide.imageCredit && (
					<figcaption class="mx-auto mt-3 max-w-[560px] text-center text-xs leading-relaxed text-[var(--ink)]/45" set:html={md(guide.imageCredit)} />
				)}
			</figure>
		)}

		<div class="mx-auto mt-12 max-w-[680px]">
			<div class="placard">
				<p class="wall-label-dept m-0">In brief</p>
				<p class="font-prose mt-3 mb-0 text-[1.15rem] leading-relaxed text-[var(--ink)]">{guide.coreSummary}</p>
			</div>

			<div class="adsterra-slots">
				<script
					async="async"
					data-cfasync="false"
					src="https://pl31132694.profitableratecpmnetwork.com/0e3eabde3076d5d5594df39e9a842c2d/invoke.js"></script>
				<div id="container-0e3eabde3076d5d5594df39e9a842c2d"></div>

				<script is:inline>
					atOptions = {
						'key': 'ef6522510c5ba434a7d7d2e91090951e',
						'format': 'iframe',
						'height': 250,
						'width': 300,
						'params': {},
					};
				</script>
				<script is:inline src="https://www.highrevenueformat.com/ef6522510c5ba434a7d7d2e91090951e/invoke.js"></script>

				<div class="adsterra-leaderboard">
					<script is:inline>
						atOptions = {
							'key': '6b65c698bbce4fd44dc184d7055bbe55',
							'format': 'iframe',
							'height': 90,
							'width': 728,
							'params': {},
						};
					</script>
					<script is:inline src="https://www.highrevenueformat.com/6b65c698bbce4fd44dc184d7055bbe55/invoke.js"></script>
				</div>
			</div>

			<article class="mt-12">
				{guide.sections.map((section) => (
					<section class="mb-11 last:mb-0">
						<h2 class="font-display mb-4 text-[1.65rem] leading-snug font-medium text-[var(--ink)]">{section.heading}</h2>
						{section.body.map((paragraph) => (
							<p class="font-prose mb-4 text-[1.08rem] leading-[1.85] text-[var(--ink)]/85 last:mb-0" set:html={md(paragraph)} />
						))}
						{section.image && (
							<figure class="m-0 mt-7">
								{/* 同上（2026-09-13 CLS 根因修复），换成正文配图自己的断点高度 */}
								<div
									class="plate section-plate mx-auto max-w-full"
									style={imgDims(section.image.src) ? `--pw: ${imgDims(section.image.src)!.w}; --ph: ${imgDims(section.image.src)!.h};` : undefined}
								>
									<img
										src={section.image.src}
										alt={section.image.alt}
										class="mx-auto h-auto max-h-[528px] w-auto max-w-full md:max-h-[65vh]"
										loading="lazy"
						width={imgDims(section.image.src)?.w}
						height={imgDims(section.image.src)?.h}
						style={imgDims(section.image.src) ? `aspect-ratio: ${imgDims(section.image.src)!.w} / ${imgDims(section.image.src)!.h};` : undefined}
					/>
								</div>
								{section.image.credit && (
									<figcaption class="mx-auto mt-3 max-w-[560px] text-center text-xs leading-relaxed text-[var(--ink)]/45" set:html={md(section.image.credit)} />
								)}
							</figure>
						)}
					</section>
				))}
			</article>

			{guide.faq && guide.faq.length > 0 && (
				<div class="mt-14 border-t-2 border-[var(--ink)] pt-6">
					<h2 class="font-display m-0 text-2xl font-medium text-[var(--ink)]">Frequently asked questions</h2>
					<div class="mt-2 flex flex-col">
						{guide.faq.map((item) => (
							<div class="border-b border-[var(--rule)] py-5 last:border-b-0">
								<p class="font-display m-0 text-[1.15rem] font-medium text-[var(--ink)]">{item.question}</p>
								<p class="mt-2 mb-0 text-[0.95rem] leading-relaxed text-[var(--ink)]/65" set:html={md(item.answer)} />
							</div>
						))}
					</div>
				</div>
			)}

			{guide.sources && guide.sources.length > 0 && (
				<div class="mt-12 border-t border-[var(--rule)] pt-5">
					<p class="wall-label-dept m-0">Sources</p>
					<ul class="mt-3 mb-0 list-none pl-0 text-sm text-[var(--ink)]/65">
						{guide.sources.map((s) => (
							<li class="py-1">
								<a href={s.url} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{s.label}</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>

		{relatedFinal.length > 0 && (
			<div class="mt-16">
				<h3 class="font-display m-0 text-xl font-medium text-[var(--ink)]">Nearby in the gallery</h3>
				<div class="mt-6 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
					{relatedFinal.map((g) => (
						<a href={`/${g.slug}/`} class="work block no-underline">
							{g.image ? (
								<figure class="plate m-0">
									<img src={g.image} alt={g.imageAlt ?? g.title} class="aspect-[4/3] w-full object-cover" loading="lazy"
						width={imgDims(g.image)?.w}
						height={imgDims(g.image)?.h}
					/>
								</figure>
							) : (
								<div class="placard">
									<p class="font-display m-0 text-base leading-snug text-[var(--ink)]/85">{g.title}</p>
								</div>
							)}
							<div class="mt-2.5 px-0.5">
								<p class="wall-label-dept m-0">{g.category}</p>
								<p class="font-display work-title m-0 mt-1 text-[1.05rem] leading-snug font-medium text-[var(--ink)]">{g.title}</p>
							</div>
						</a>
					))}
				</div>
			</div>
		)}

		<div class="mx-auto mt-14 max-w-[680px] border-t border-[var(--rule)] pt-5 text-sm text-[var(--ink)]/55">
			<p class="m-0">Written and edited by the <a href="/about/" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{AUTHOR_NAME}</a></p>
		</div>
	</div>
</Layout>

<style>
	/* 2026-09-13 CLS 根因修复：用已知宽高比 + 该断点的 max-height 直接算出 .plate 的
	   确定宽度，不再靠 width:fit-content 收缩贴合 img 自身渲染出的尺寸（后者在图片资源
	   到位前会被 Chrome 算错，产生真实布局偏移）。数值要跟对应 <img> 的 max-h-[...] /
	   md:max-h-[...] 断点保持一致，改图片尺寸规则时这两处要一起改。 */
	.hero-plate {
		width: min(100%, calc(585px * var(--pw, 1) / var(--ph, 1)));
	}
	@media (min-width: 768px) {
		.hero-plate {
			width: min(100%, calc(72vh * var(--pw, 1) / var(--ph, 1)));
		}
	}
	.section-plate {
		width: min(100%, calc(528px * var(--pw, 1) / var(--ph, 1)));
	}
	@media (min-width: 768px) {
		.section-plate {
			width: min(100%, calc(65vh * var(--pw, 1) / var(--ph, 1)));
		}
	}
	.adsterra-slots {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		padding: 1.5rem 0;
	}
	.adsterra-leaderboard {
		max-width: 100%;
		overflow-x: auto;
	}
	.work .plate {
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.work:hover .plate {
		transform: translateY(-2px);
		box-shadow:
			0 2px 4px rgb(33 31 28 / 0.06),
			0 16px 36px -14px rgb(33 31 28 / 0.24);
	}
	.work:hover .work-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	@media (prefers-reduced-motion: reduce) {
		.work .plate {
			transition: none;
		}
		.work:hover .plate {
			transform: none;
		}
	}
</style>
