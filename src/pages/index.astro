---
import Layout from '../layouts/Layout.astro';
import { guides, categorySlug } from '../data/guides';

const sorted = [...guides].sort((a, b) => b.updated.localeCompare(a.updated));
const [lead, ...rest] = sorted;
const wall = rest.slice(0, 18);

const counts = new Map<string, number>();
for (const g of guides) {
	counts.set(g.category, (counts.get(g.category) ?? 0) + 1);
}
const rooms = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Layout>
	{lead && (
		<a href={`/${lead.slug}/`} class="lead grid items-center gap-8 no-underline md:grid-cols-12 md:gap-12">
			<div class="order-2 md:order-1 md:col-span-5">
				<p class="wall-label-dept m-0">{lead.category}</p>
				<h1 class="font-display mt-3 text-4xl leading-[1.08] font-medium text-[var(--ink)] md:text-5xl">
					{lead.title}
				</h1>
				<div class="mt-5 h-px w-14 bg-[var(--flag)]"></div>
				<p class="mt-5 max-w-md text-[1.02rem] leading-relaxed text-[var(--ink)]/65">{lead.description}</p>
				<p class="mt-6 mb-0 text-sm font-medium text-[var(--flag-dark)] underline underline-offset-4">
					Read the study
				</p>
			</div>
			{lead.image ? (
				<figure class="plate order-1 m-0 w-fit max-w-full justify-self-center md:order-2 md:col-span-7">
					<img
						src={lead.image}
						alt={lead.imageAlt ?? lead.title}
						class="mx-auto h-auto max-h-[62vh] w-auto max-w-full"
						loading="eager"
					/>
				</figure>
			) : (
				<div class="placard order-1 md:order-2 md:col-span-7">
					<p class="font-display m-0 text-2xl leading-snug text-[var(--ink)]/80">{lead.coreSummary}</p>
				</div>
			)}
		</a>
	)}

	{rooms.length > 0 && (
		<nav class="mt-14 flex flex-wrap items-baseline gap-x-8 gap-y-2 border-y border-[var(--rule)] py-3.5">
			<span class="font-display text-[1.05rem] text-[var(--ink)]/85">Rooms</span>
			{rooms.map(([category, n]) => (
				<a
					href={`/topics/${categorySlug(category)}/`}
					class="text-[0.9rem] text-[var(--ink)]/65 no-underline hover:text-[var(--flag-dark)] hover:underline"
				>
					{category} <span class="text-[var(--ink)]/35">{n}</span>
				</a>
			))}
		</nav>
	)}

	{wall.length > 0 && (
		<section class="mt-12">
			<h2 class="font-display m-0 text-2xl font-medium text-[var(--ink)]">The collection</h2>
			<div class="mt-7 columns-1 gap-8 sm:columns-2 lg:columns-3">
				{wall.map((g) => (
					<a href={`/${g.slug}/`} class="work mb-9 block break-inside-avoid no-underline">
						{g.image ? (
							<figure class="plate m-0">
								<img src={g.image} alt={g.imageAlt ?? g.title} loading="lazy" />
							</figure>
						) : (
							<div class="placard">
								<p class="font-display m-0 text-lg leading-snug text-[var(--ink)]/85">{g.title}</p>
							</div>
						)}
						<div class="mt-3 px-0.5">
							<p class="wall-label-dept m-0">{g.category}</p>
							<p class="font-display work-title m-0 mt-1 text-[1.2rem] leading-snug font-medium text-[var(--ink)]">
								{g.title}
							</p>
							<p class="m-0 mt-1.5 text-sm leading-relaxed text-[var(--ink)]/55">{g.description}</p>
						</div>
					</a>
				))}
			</div>
		</section>
	)}

	{!lead && (
		<div class="mt-10 text-sm text-[var(--ink)]/40">
			<p>Nothing published yet. <a href="/about/" class="text-[var(--flag-dark)] underline underline-offset-2">What this site is for</a>.</p>
		</div>
	)}
</Layout>

<style>
	.lead .plate,
	.work .plate {
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.lead:hover .plate,
	.work:hover .plate {
		transform: translateY(-2px);
		box-shadow:
			0 2px 4px rgb(33 31 28 / 0.06),
			0 16px 36px -14px rgb(33 31 28 / 0.24);
	}
	.work:hover .work-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	@media (prefers-reduced-motion: reduce) {
		.lead .plate,
		.work .plate {
			transition: none;
		}
		.lead:hover .plate,
		.work:hover .plate {
			transform: none;
		}
	}
</style>
