---
import Layout from '../layouts/Layout.astro';
import { guides } from '../data/guides';

const sorted = [...guides].sort((a, b) => b.updated.localeCompare(a.updated));
const [lead, ...rest] = sorted;
const index = rest.slice(0, 16);
---

<Layout>
	<div class="border-b border-[var(--ink)] pb-3">
		<p class="m-0 text-sm leading-relaxed text-[var(--ink)]/60">
			Visual art history, checked against the record. Paintings and buildings, the pigments they
			were made from, and the forgeries and thefts that keep rewriting the catalogue.
		</p>
	</div>

	{lead && (
		<a href={`/${lead.slug}/`} class="lead mt-8 flex flex-col gap-4 no-underline md:flex-row md:gap-8">
			{lead.image && (
				<img src={lead.image} alt={lead.title} class="aspect-[4/3] w-full object-cover md:w-[38%]" loading="eager" />
			)}
			<div class="flex-1">
				<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--flag-dark)]">{lead.category}</p>
				<h1 class="font-display mt-2 text-3xl font-bold leading-[1.1] text-[var(--ink)] md:text-4xl">{lead.title}</h1>
				<p class="mt-3 max-w-xl text-base leading-relaxed text-[var(--ink)]/60">{lead.description}</p>
			</div>
		</a>
	)}

	{index.length > 0 && (
		<div class="mt-12 border-t border-[var(--ink)] pt-6">
			<h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--ink)]/45">More</h2>
			<div class="columns-1 gap-x-10 md:columns-2">
				{index.map((g) => (
					<a href={`/${g.slug}/`} class="item mb-5 block break-inside-avoid border-b border-[var(--rule)] pb-5 no-underline">
						<p class="m-0 text-[0.65rem] font-semibold uppercase tracking-wide text-[var(--flag-dark)]/80">{g.category}</p>
						<p class="font-display m-0 mt-1 text-base font-bold leading-snug text-[var(--ink)]">{g.title}</p>
						<p class="m-0 mt-1 text-sm text-[var(--ink)]/55">{g.description}</p>
					</a>
				))}
			</div>
		</div>
	)}

	{!lead && (
		<div class="mt-10 text-sm text-[var(--ink)]/40">
			<p>Nothing published yet. <a href="/about/" class="text-[var(--flag-dark)] underline underline-offset-2">What this site is for</a>.</p>
		</div>
	)}
</Layout>

<style>
	.lead {
		transition: opacity 0.15s ease;
	}
	.lead:hover .font-display {
		text-decoration: underline;
	}
	.item {
		transition: padding-left 0.15s ease;
	}
	.item:hover {
		padding-left: 0.4rem;
	}
</style>
