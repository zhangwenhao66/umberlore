---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION, ADSENSE_PUBLISHER_ID, GA4_ID, CLARITY_ID, SITE_ORIGIN, BRAND_SAME_AS, BRAND_DESCRIPTION, CONTACT_EMAIL, BRAND_KNOWS_ABOUT } from '../consts';
import Organization from '../../vendor/site-toolkit/packages/schema/src/Organization.astro';
// 2026-09-13 CWV 修复：怀疑图片"unsized"导致 CLS，加了 aspect-ratio 后重测完全无变化
// （section 分数和成因判定分毫不差）——重新排查发现真正来源跟 commsadvisor 同款：
// `@fontsource-variable/eb-garamond` 默认 font-display:swap，标题字体切换时正文重排。
// 加 aspect-ratio 那次修复留着无害，字体才是真正根因，用同一套 preload 方案。
import ebGaramondUrl from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: string;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	ogImage = '/favicon.svg',
	ogType = 'website',
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f3f2ef" />
		<link rel="preload" href={ebGaramondUrl} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href="/rss.xml" />
		<meta name="robots" content="max-image-preview:large" />
		<meta name="p:domain_verify" content="04e688aba06704cc434af98ee1eaac1d" />

		<meta name="google-adsense-account" content={ADSENSE_PUBLISHER_ID} />
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-${ADSENSE_PUBLISHER_ID}`}
			crossorigin="anonymous"></script>

		<script
			async
			src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
		<script is:inline define:vars={{ GA4_ID }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', GA4_ID);
		</script>

		<script is:inline define:vars={{ CLARITY_ID }}>
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = 'https://www.clarity.ms/tag/' + i + '?ref=bwt';
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, 'clarity', 'script', CLARITY_ID);
		</script>

		<title>{pageTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- 品牌实体（2026-09-10）：publisher 级 Organization，sameAs 来自 consts.BRAND_SAME_AS -->
		<!-- 2026-09-13：补 description/contactPoint/knowsAbout，参考鸭老师《SEO的完整总结》实体信号一节 -->
		<Organization
			name={SITE_TITLE}
			url={`${SITE_ORIGIN}/`}
			logo={`${SITE_ORIGIN}/logo-512.png`}
			sameAs={BRAND_SAME_AS}
			description={BRAND_DESCRIPTION}
			email={CONTACT_EMAIL}
			knowsAbout={BRAND_KNOWS_ABOUT}
		/>
		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col">
		<Header />
		<main class="mx-auto w-full max-w-6xl flex-1 px-5 py-10 md:px-8">
			<slot />
		</main>
		<Footer />
	</body>
</html>
