---
import { SITE_TITLE } from '../consts';
---

<!-- Catalogue masthead: serif wordmark over a double rule, the way exhibition
     catalogues open. Nav labels unchanged (Topics / About). -->
<header class="bg-[var(--paper)]">
	<div class="mx-auto max-w-6xl px-5 md:px-8">
		<nav class="flex items-end justify-between gap-2 pt-6 pb-3">
			<a href="/" class="flex shrink-0 items-baseline gap-2.5 no-underline" aria-label={`${SITE_TITLE} home`}>
				<!-- A paint tube: umber is the pigment the site is named after. -->
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="self-center">
					<path d="M5.2 8.4 L9 5.6 L9 18.4 L5.2 15.6 C4.3 14.9 4.3 9.1 5.2 8.4 Z" fill="var(--flag-dark)"/>
					<rect x="9" y="5.2" width="8.4" height="13.6" rx="1.1" fill="var(--flag)"/>
					<rect x="17.4" y="9.2" width="2.4" height="5.6" rx="0.7" fill="var(--flag-dark)"/>
					<rect x="10.6" y="8.6" width="5.2" height="1.5" rx="0.7" fill="var(--paper)" opacity="0.75"/>
				</svg>
				<span class="font-display text-[1.7rem] leading-none font-medium tracking-tight text-[var(--ink)]">{SITE_TITLE}</span>
			</a>

			<div class="flex items-baseline gap-6 pb-0.5">
				<a href="/topics/" class="nav-link text-[0.85rem] text-[var(--ink)]/70 no-underline">Topics</a>
				<a href="/about/" class="nav-link text-[0.85rem] text-[var(--ink)]/70 no-underline">About</a>
			</div>
		</nav>
	</div>
	<div class="mx-auto max-w-6xl px-5 md:px-8">
		<div class="border-b-2 border-[var(--ink)]"></div>
		<div class="mt-[3px] border-b border-[var(--rule)]"></div>
	</div>
</header>

<style>
	.nav-link:hover {
		color: var(--flag-dark);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
